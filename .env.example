# Copy to .env.local for local development. Never commit real values.

# Postgres connection string (Neon via Vercel Marketplace in production).
# Leave empty locally to use the in-process PGlite database.
DATABASE_URL=

# LLM provider settings. Any OpenAI-compatible endpoint (see ADR 0003).
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Shared password for the demo gate. Use a long random value in production.
DEMO_PASSWORD=

# HMAC key for signed session cookies. 32+ random bytes, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Bearer token Vercel Cron sends to /api/watch/run (optional).
CRON_SECRET=
