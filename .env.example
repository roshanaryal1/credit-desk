# Copy to .env.local for local development. Never commit real values.

# Postgres connection string (Neon via Vercel Marketplace in production).
DATABASE_URL=postgres://user:password@localhost:5432/invoice_check

# LLM provider settings. Any OpenAI-compatible endpoint works (see ADR 0003).
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Shared password for the demo gate. Use a long random value in production.
DEMO_PASSWORD=
